{
  "name": "minefleet",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "clean": "turbo clean",
    "build:controller": "pnpm --filter @minefleet/shared-types build && pnpm --filter @minefleet/protocol build && pnpm --filter @minefleet/controller build",
    "start:controller": "node apps/controller/dist/index.js"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
