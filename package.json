{
  "name": "minefleet",
  "private": true,
  "scripts": {
    "build": "turbo build && node -e \"const fs=require('fs'); fs.cpSync('apps/dashboard/dist', 'dist', {recursive: true});\"",
    "dev": "turbo dev",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "clean": "turbo clean && rimraf dist",
    "build:controller": "pnpm --filter @minefleet/shared-types build && pnpm --filter @minefleet/protocol build && pnpm --filter @minefleet/controller build",
    "start:controller": "node apps/controller/dist/index.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/jwt": "^9.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@sinclair/typebox": "^0.34.52",
    "@upstash/redis": "^1.38.3",
    "bcrypt": "^5.1.1",
    "fastify": "^5.12.1",
    "pino": "^9.14.0",
    "pino-pretty": "^13.1.3",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/uuid": "^10.0.0",
    "rimraf": "^6.0.0",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
