FROM node:20-alpine AS builder
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml turbo.json tsconfig.base.json ./
COPY packages/ ./packages/
COPY apps/controller/ ./apps/controller/
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @minefleet/shared-types build
RUN pnpm --filter @minefleet/protocol build
RUN pnpm --filter @minefleet/controller build

FROM node:20-alpine
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app
COPY --from=builder /app .
EXPOSE 3001

# Run migrations then start
CMD ["sh", "-c", "pnpm --filter @minefleet/controller db:migrate && pnpm --filter @minefleet/controller seed && pnpm --filter @minefleet/controller start"]
