# MineFleet Configuration

# Controller
CONTROLLER_HOST=0.0.0.0
CONTROLLER_PORT=3001
CONTROLLER_URL=http://localhost:3001

# Database
DATABASE_URL=postgresql://minefleet:minefleet_dev@localhost:5432/minefleet

# JWT
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
JWT_REFRESH_SECRET=CHANGE_ME_TO_ANOTHER_RANDOM_64_CHAR_STRING
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Admin seed
ADMIN_EMAIL=admin@minefleet.local
ADMIN_PASSWORD=CHANGE_ME

# Dashboard
DASHBOARD_PORT=3000

# Agent (set by installer)
# AGENT_CONTROLLER_URL=https://your-controller.example.com
# AGENT_TOKEN=<machine-api-token>
