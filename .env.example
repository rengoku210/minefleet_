# MineFleet Environment Variables (Vercel & Local)

# Persistent Storage (Optional on Vercel: Upstash Redis via Vercel Marketplace)
# If not provided, MineFleet automatically runs in in-memory storage mode.
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# Security Secrets
JWT_SECRET=minefleet_super_secret_jwt_random_key_production_2026_xyz
JWT_REFRESH_SECRET=minefleet_super_secret_refresh_random_key_production_2026_abc

# Admin Credentials (Auto-initialized on first login)
ADMIN_EMAIL=admin@minefleet.local
ADMIN_PASSWORD=Admin1234!

# Application URLs
CONTROLLER_URL=https://your-minefleet-project.vercel.app
VITE_CONTROLLER_URL=https://your-minefleet-project.vercel.app
