{
  "name": "@minefleet/controller",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist .turbo",
    "db:migrate": "node-pg-migrate up --migration-file-language ts --tsconfig tsconfig.json",
    "db:migrate:down": "node-pg-migrate down --migration-file-language ts --tsconfig tsconfig.json",
    "db:migrate:create": "node-pg-migrate create --migration-file-language ts",
    "seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/jwt": "^9.0.0",
    "@fastify/rate-limit": "^10.2.0",
    "@fastify/websocket": "^11.0.0",
    "@minefleet/protocol": "workspace:*",
    "@minefleet/shared-types": "workspace:*",
    "@sinclair/typebox": "^0.34.0",
    "bcrypt": "^5.1.1",
    "fastify": "^5.2.0",
    "node-pg-migrate": "^7.9.0",
    "pg": "^8.13.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/pg": "^8.11.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.0",
    "rimraf": "^6.0.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
